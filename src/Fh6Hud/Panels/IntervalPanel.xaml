<fh6:PanelWindow x:Class="Fh6Hud.Panels.IntervalPanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:fh6="clr-namespace:Fh6Hud"
                 Title="FH6 HUD Intervals">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Padding="14,13"
            MinWidth="320">
        <StackPanel>
            <Grid>
                <TextBlock Text="INTERVAL TIMERS"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="Bold"/>
                <TextBlock Text="0 - 300 KM/H"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"/>
            </Grid>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="0-100" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="T0_100_Time" Text="--.--" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource ReadyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                <TextBlock x:Name="T0_100_State" Text="READY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" Grid.Column="2"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="100-200" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="T100_200_Time" Text="--.--" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource ReadyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                <TextBlock x:Name="T100_200_State" Text="READY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" Grid.Column="2"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="200-300" Foreground="{StaticResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock x:Name="T200_300_Time" Text="--.--" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource ReadyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                <TextBlock x:Name="T200_300_State" Text="READY" Foreground="{StaticResource MutedBrush}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" Grid.Column="2"/>
            </Grid>

            <Grid x:Name="SpeedBarTrack"
                  Height="10"
                  Background="{StaticResource ProgressTrackBrush}"
                  ClipToBounds="True"
                  Margin="0,16,0,0">
                <Border x:Name="SpeedBarFill"
                        Width="0"
                        HorizontalAlignment="Left"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="4"/>
            </Grid>
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="100" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="200" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="11"/>
                <TextBlock Text="300" Grid.Column="3" Foreground="{StaticResource MutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
            </Grid>
        </StackPanel>
    </Border>
</fh6:PanelWindow>
