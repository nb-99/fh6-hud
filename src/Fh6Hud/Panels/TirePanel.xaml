<fh6:PanelWindow x:Class="Fh6Hud.Panels.TirePanel"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:fh6="clr-namespace:Fh6Hud"
                 Title="FH6 HUD Tires">
    <Border Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="11"
            Padding="14,13">
        <StackPanel>
            <Grid>
                <TextBlock Text="TIRE TEMPERATURE"
                           Foreground="{StaticResource TextBrush}"
                           FontSize="13"
                           FontWeight="Bold"/>
            </Grid>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="128"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="128"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="108"/>
                    <RowDefinition Height="9"/>
                    <RowDefinition Height="108"/>
                </Grid.RowDefinitions>

                <Border x:Name="TireFlCard"
                        Grid.Row="0"
                        Grid.Column="0"
                        Background="{StaticResource TireColdFillBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="FL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TireFlState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TireFl" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border x:Name="TireFrCard"
                        Grid.Row="0"
                        Grid.Column="2"
                        Background="{StaticResource TireColdFillBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="FR" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TireFrState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TireFr" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border x:Name="TireRlCard"
                        Grid.Row="2"
                        Grid.Column="0"
                        Background="{StaticResource TireColdFillBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="RL" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TireRlState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TireRl" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>

                <Border x:Name="TireRrCard"
                        Grid.Row="2"
                        Grid.Column="2"
                        Background="{StaticResource TireColdFillBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <TextBlock Text="RR" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="Bold"/>
                            <TextBlock x:Name="TireRrState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,1,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="TireRr" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </Grid>

            <TextBlock x:Name="TireRangeText"
                       Text="TARGET 72-90 °C"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource SecondaryBrush}"
                       FontFamily="{StaticResource DigitFont}"
                       FontSize="13"
                       FontWeight="Bold"
                       Margin="0,12,0,0"/>
        </StackPanel>
    </Border>
</fh6:PanelWindow>
