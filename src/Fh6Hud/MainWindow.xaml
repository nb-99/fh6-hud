<Window x:Class="Fh6Hud.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FH6 HUD"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="Height"
        Width="560"
        WindowStartupLocation="Manual"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.ContextMenu>
        <ContextMenu>
            <MenuItem Header="Tire compound" x:Name="TireCompoundMenu">
                <MenuItem Header="Standard" Tag="Standard" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Street" Tag="Street" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Sport" Tag="Sport" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Rally" Tag="Rally" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Semi-Slick" Tag="Semi-Slick" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Slick" Tag="Slick" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Offroad" Tag="Offroad" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Snow" Tag="Snow" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Vintage" Tag="Vintage" IsCheckable="True" Click="Compound_Click"/>
                <MenuItem Header="Vintage Race" Tag="Vintage Race" IsCheckable="True" Click="Compound_Click"/>
            </MenuItem>
            <MenuItem Header="Reset all timers" Click="ResetTimers_Click"/>
            <MenuItem Header="Click-through (pass input to game)" Click="ToggleClickThrough_Click"/>
            <Separator/>
            <MenuItem Header="Quit" Click="Quit_Click"/>
        </ContextMenu>
    </Window.ContextMenu>

        <Grid>
            <Border x:Name="HudPanel"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Padding="20,16"
            MouseLeftButtonDown="Panel_MouseLeftButtonDown">
        <StackPanel>
            <Grid>
                <StackPanel VerticalAlignment="Top">
                    <TextBlock Text="FH6 // TELEMETRY"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="13"
                               FontWeight="Bold"/>
                    <TextBlock Text="LIVE VEHICLE OVERLAY"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="10"
                               Margin="0,3,0,0"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Ellipse x:Name="StatusDot"
                                 Width="8"
                                 Height="8"
                                 Fill="{StaticResource HotBrush}"
                                 Margin="0,4,7,0"/>
                        <TextBlock x:Name="StatusText"
                                   Text="WAITING FOR TELEMETRY"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,7,0,0">
                        <Border x:Name="GearChip"
                                Background="{StaticResource CardBrush}"
                                BorderBrush="{StaticResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="9,5"
                                VerticalAlignment="Bottom"
                                Margin="0,0,10,4">
                            <TextBlock x:Name="GearText"
                                       Text="--"
                                       FontFamily="{StaticResource DigitFont}"
                                       FontSize="17"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"/>
                        </Border>
                        <TextBlock x:Name="SpeedText"
                                   Text="--"
                                   FontFamily="{StaticResource DigitFont}"
                                   FontSize="42"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}"
                                   LineHeight="42"/>
                        <TextBlock Text="KM/H"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   FontWeight="Bold"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,6"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="{StaticResource DividerBrush}" Margin="0,14,0,0"/>

            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Tire temperature card -->
                <Border Grid.Column="0"
                        Grid.Row="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="14,13">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TIRE TEMPERATURE"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock x:Name="TireRangeText"
                                       Text="TARGET 86-104 °C"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="98"/>
                                <RowDefinition Height="8"/>
                                <RowDefinition Height="98"/>
                            </Grid.RowDefinitions>

                            <Border x:Name="TireFlCard"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Background="{StaticResource TireColdFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="FL" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="TireFlState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TireFl" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <Border x:Name="TireFrCard"
                                    Grid.Row="0"
                                    Grid.Column="2"
                                    Background="{StaticResource TireColdFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="FR" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="TireFrState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TireFr" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <Border x:Name="TireRlCard"
                                    Grid.Row="2"
                                    Grid.Column="0"
                                    Background="{StaticResource TireColdFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="RL" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="TireRlState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TireRl" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>

                            <Border x:Name="TireRrCard"
                                    Grid.Row="2"
                                    Grid.Column="2"
                                    Background="{StaticResource TireColdFillBrush}"
                                    BorderBrush="{StaticResource CardBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                                        <TextBlock Text="RR" Foreground="{StaticResource AccentBrush}" FontSize="10" FontWeight="Bold"/>
                                        <TextBlock x:Name="TireRrState" Text="--" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="8,1,0,0"/>
                                    </StackPanel>
                                    <TextBlock x:Name="TireRr" Text="--°" FontFamily="{StaticResource DigitFont}" FontSize="27" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Bottom"/>
                                </Grid>
                            </Border>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Ellipse Width="7" Height="7" Fill="{StaticResource ColdBrush}" Margin="0,2,5,0"/>
                            <TextBlock Text="COLD" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,13,0"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource OkBrush}" Margin="0,2,5,0"/>
                            <TextBlock Text="IN RANGE" Foreground="{StaticResource MutedBrush}" FontSize="9" Margin="0,0,13,0"/>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource HotBrush}" Margin="0,2,5,0"/>
                            <TextBlock Text="HOT" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Engine card -->
                <Border Grid.Column="2"
                        Grid.Row="0"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="14,13">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="ENGINE"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock Text="POWER"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock x:Name="RpmText"
                                       Text="----"
                                       FontFamily="{StaticResource DigitFont}"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock x:Name="RpmMaxText"
                                       Text="/ ---- RPM"
                                       FontFamily="{StaticResource DigitFont}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}"
                                       VerticalAlignment="Bottom"
                                       Margin="6,0,0,3"/>
                        </StackPanel>

                        <Grid x:Name="RpmBarTrack" Height="7" Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="9*"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource ProgressTrackBrush}" CornerRadius="3,0,0,3"/>
                            <Border Grid.Column="1" Background="{StaticResource RedlineBrush}" CornerRadius="0,3,3,0"/>
                            <Border x:Name="RpmBarFill"
                                    Grid.ColumnSpan="2"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="3"/>
                        </Grid>

                        <Canvas x:Name="PowerCurveCanvas"
                                Height="80"
                                Margin="0,12,0,0"
                                ClipToBounds="True"
                                HorizontalAlignment="Stretch">
                            <Polyline x:Name="PowerCurveLine"
                                      Stroke="{StaticResource AccentBrush}"
                                      StrokeThickness="1.5"/>
                            <Ellipse x:Name="PowerCurveDot"
                                     Width="6"
                                     Height="6"
                                     Fill="{StaticResource TimingBrush}"
                                     Visibility="Collapsed"/>
                        </Canvas>

                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="MAX POWER" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                <TextBlock x:Name="MaxPsText"
                                           Text="--- PS"
                                           FontFamily="{StaticResource DigitFont}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="CURRENT POWER" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                                <TextBlock x:Name="CurPsText"
                                           Text="--- PS"
                                           FontFamily="{StaticResource DigitFont}"
                                           FontSize="16"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SecondaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Interval timers card -->
                <Border Grid.Column="0"
                        Grid.ColumnSpan="2"
                        Grid.Row="1"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11"
                        Padding="14,13"
                        Margin="0,12,0,0">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="INTERVAL TIMERS"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"/>
                            <TextBlock Text="0 - 300 KM/H"
                                       HorizontalAlignment="Right"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="9"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0-100" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="T0_100_Time" Text="--.--" FontFamily="{StaticResource DigitFont}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ReadyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                            <TextBlock x:Name="T0_100_State" Text="READY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" Grid.Column="2"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="100-200" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="T100_200_Time" Text="--.--" FontFamily="{StaticResource DigitFont}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ReadyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                            <TextBlock x:Name="T100_200_State" Text="READY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" Grid.Column="2"/>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="200-300" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="T200_300_Time" Text="--.--" FontFamily="{StaticResource DigitFont}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource ReadyBrush}" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="1"/>
                            <TextBlock x:Name="T200_300_State" Text="READY" Foreground="{StaticResource MutedBrush}" FontSize="10" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" Grid.Column="2"/>
                        </Grid>

                        <Grid x:Name="SpeedBarTrack"
                              Height="7"
                              Background="{StaticResource ProgressTrackBrush}"
                              ClipToBounds="True"
                              Margin="0,14,0,0">
                            <Border x:Name="SpeedBarFill"
                                    Width="0"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource AccentBrush}"
                                    CornerRadius="4"/>
                        </Grid>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="0" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                            <TextBlock Text="100" Grid.Column="1" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                            <TextBlock Text="200" Grid.Column="2" Foreground="{StaticResource MutedBrush}" FontSize="9"/>
                            <TextBlock Text="300" Grid.Column="3" Foreground="{StaticResource MutedBrush}" FontSize="9" HorizontalAlignment="Right"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Margin="0,15,0,0">
                <TextBlock x:Name="FooterLeft"
                           Text="DATA OUT  |  60 HZ"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"/>
                <TextBlock x:Name="ClickThroughHint"
                           Text="CTRL+ALT+H  CLICK-THROUGH"
                           HorizontalAlignment="Right"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="9"/>
            </Grid>
        </StackPanel>
        </Border>

        <!-- Minimal status chip shown instead of the panel while there is no
             live data (menu, garage, telemetry gap). Keeps the right-click
             context menu reachable. -->
        <Border x:Name="NoDataChip"
                Visibility="Collapsed"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="12,8">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{StaticResource HotBrush}" Margin="0,0,7,0"/>
                <TextBlock x:Name="NoDataChipText"
                           Text="FH6 // NO DATA"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="10"
                           FontWeight="SemiBold"/>
            </StackPanel>
        </Border>
        </Grid>
</Window>
